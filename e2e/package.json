{
  "name": "equipment-rental-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end browser tests against a locally running stack (Angular, Spring Boot, Keycloak, MinIO, Mailpit).",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep-invert @smoke",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium",
    "install-all-browsers": "playwright install",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  }
}
